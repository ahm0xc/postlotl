{
  "name": "postlotl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter web... dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web... build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check-types": "pnpm -r check-types",
    "db:push": "cd apps/web && pnpm exec drizzle-kit push",
    "db:studio": "cd apps/web && pnpm exec drizzle-kit studio",
    "db:migrate": "cd apps/web && pnpm exec drizzle-kit migrate"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2"
}
